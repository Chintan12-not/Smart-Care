# ==============================================================================
# SMART CARE MOBILE — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Domain: https://smartcaremobile.in
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE / PUBLIC ENVIRONMENT VARIABLES (Exposed to Browser)
# Must start with NEXT_PUBLIC_
# ------------------------------------------------------------------------------

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase Authentication Credentials
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=auth.smartcaremobile.in
NEXT_PUBLIC_FIREBASE_PROJECT_ID=smart-care-fd4f2
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=smart-care-fd4f2.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=241263098843
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Razorpay Client Key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id

# Web3Forms Public Key (Corporate Lead Contact Form)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Appwrite Credentials (Optional)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-appwrite-project-id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your-database-id
NEXT_PUBLIC_APPWRITE_B2B_COLLECTION_ID=your-b2b-collection-id


# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Cloudflare Workers Environment Secrets)
# DO NOT prefix with NEXT_PUBLIC_. Keep these secure!
# Set using Cloudflare Workers Dashboard or `wrangler secret put <KEY_NAME>`
# ------------------------------------------------------------------------------

# Razorpay Payment Gateway Secrets
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Resend Email Service API Key
RESEND_API_KEY=re_your_resend_api_key

# Google Gemini AI API Key (Description Generator & Mobile Assistant)
GEMINI_API_KEY=your-gemini-api-key

# Google Maps API Key (Distance Calculation Service)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
